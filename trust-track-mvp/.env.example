# API
PORT=4100
WEB_ORIGIN=http://localhost:5174
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trust_track

# Google Workspace pilot configuration
# The production Cloud project must be owned by the site's Workspace organization
# and configured with an Internal OAuth user type.
GOOGLE_WORKSPACE_DOMAIN=exampleclinicalsite.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_SECRET_NAME=
GOOGLE_SHARED_MAILBOX=research@exampleclinicalsite.com
GMAIL_POLL_INTERVAL_SECONDS=60
GMAIL_POLL_OVERLAP_SECONDS=300

# Sensitive-data processing
STORE_RAW_EMAIL_CONTENT=false
PHI_REVIEW_MODE=quarantine
SUBJECT_REGISTRY_ENABLED=false

# Product controls
DEFAULT_TIME_ZONE=America/New_York
INDIVIDUAL_LEADERBOARDS_ENABLED=false
